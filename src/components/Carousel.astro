---
interface Props {
  items: { src: string; header: string }[];
  /** Bootstrap targets the controls and indicators by selector, so a carousel
      has to be addressable by id. */
  id: string;
  class?: string;
}

const { items, id, class: className } = Astro.props;
---

<div class:list={["carousel", "slide", className]} id={id}>
  <div class="carousel-indicators">
    {
      items.map((item, i) => (
        <button
          type="button"
          data-bs-target={`#${id}`}
          data-bs-slide-to={i}
          class={i === 0 ? "active" : undefined}
          aria-current={i === 0 ? "true" : undefined}
          aria-label={item.header}
        />
      ))
    }
  </div>
  <div class="carousel-inner">
    {
      items.map((item, i) => (
        <div class:list={["carousel-item", { active: i === 0 }]}>
          <img
            class="d-block w-100"
            src={item.src}
            alt={item.header}
            loading="lazy"
          />
          <div class="carousel-caption d-none d-md-block mb-4">
            <h3>{item.header}</h3>
          </div>
        </div>
      ))
    }
  </div>
  <button
    type="button"
    class="carousel-control-prev"
    data-bs-target={`#${id}`}
    data-bs-slide="prev"
  >
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button
    type="button"
    class="carousel-control-next"
    data-bs-target={`#${id}`}
    data-bs-slide="next"
  >
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>
